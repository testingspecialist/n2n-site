/* N2N main.js — v2.0 | zero dependencies */
(function () {
  'use strict';

  /* ── Language auto-detect ──────────────────────────────────
     Runs once on first visit (no cookie/localStorage set yet).
     Reads navigator.language, maps to supported lang, redirects
     if current URL lang doesn't match. Stores choice so it only
     runs once — manual flag selection overrides it.
  ────────────────────────────────────────────────────────── */
  var LANG_KEY = 'n2n_lang';
  var SUPPORTED = ['en', 'es', 'pt'];

  function getLangFromPath() {
    var m = window.location.pathname.match(/^\/(en|es|pt)(\/|$)/);
    return m ? m[1] : null;
  }

  function getBrowserLang() {
    var nav = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
    if (nav.startsWith('es')) return 'es';
    if (nav.startsWith('pt')) return 'pt';
    return 'en';
  }

  function redirectToLang(lang) {
    var current = getLangFromPath();
    if (current === lang) return;
    var newPath = window.location.pathname.replace(/^\/(en|es|pt)(\/|$)/, '/' + lang + '/');
    if (newPath === window.location.pathname) {
      newPath = '/' + lang + window.location.pathname;
    }
    window.location.replace(newPath + window.location.search);
  }

  /* Only auto-detect if user hasn't manually chosen a language */
  if (!sessionStorage.getItem(LANG_KEY)) {
    var autoLang = getBrowserLang();
    var pathLang = getLangFromPath();
    if (pathLang && pathLang !== autoLang) {
      sessionStorage.setItem(LANG_KEY, autoLang);
      redirectToLang(autoLang);
    }
  }

  /* Mark manual selection when clicking a flag */
  document.querySelectorAll('.lang-switcher__item').forEach(function (el) {
    el.addEventListener('click', function () {
      var href = el.getAttribute('href') || '';
      var m = href.match(/\/(en|es|pt)(\/|$)/);
      if (m) sessionStorage.setItem(LANG_KEY, m[1]);
    });
  });

  /* ── Mobile nav toggle ─────────────────────────────────────── */
  var toggle = document.getElementById('nav-toggle');
  var navLinks = document.getElementById('nav-links');

  if (toggle && navLinks) {
    toggle.addEventListener('click', function () {
      var open = navLinks.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      /* swap hamburger icon to X */
      toggle.innerHTML = open
        ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>'
        : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>';
    });

    document.addEventListener('click', function (e) {
      if (!toggle.contains(e.target) && !navLinks.contains(e.target)) {
        navLinks.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && navLinks.classList.contains('is-open')) {
        navLinks.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }

  /* ── Cookie consent ────────────────────────────────────────── */
  var COOKIE_KEY = 'n2n_cookie';
  var banner = document.getElementById('cookie-banner');

  if (banner && !localStorage.getItem(COOKIE_KEY)) {
    banner.removeAttribute('hidden');
  }

  var btnAccept = document.getElementById('cookie-accept');
  var btnReject = document.getElementById('cookie-reject');

  if (btnAccept) {
    btnAccept.addEventListener('click', function () {
      localStorage.setItem(COOKIE_KEY, 'accepted');
      banner.setAttribute('hidden', '');
    });
  }
  if (btnReject) {
    btnReject.addEventListener('click', function () {
      localStorage.setItem(COOKIE_KEY, 'rejected');
      banner.setAttribute('hidden', '');
    });
  }

})();
